# Docs AI bearer token — required (App Runner name: docai_token)
# docai_token=
# (alias) DOC_AI_TOKEN=

# Optional: override default https://docs-ai-ext.cloudapps.cisco.com/api/v1/docs/ask
# DOCS_AI_ASK_URL=

# Voice: prepend instruction to the question and strip links from the answer (default on).
# VOICE_OPTIMIZED=true
# VOICE_MAX_SENTENCES=4

# Shared secret: MCP clients must send HTTP header MCP_REQUEST_HEADERS with this exact value.
# Set in AWS App Runner for production; omit locally only for testing.
# MCP_REQUEST_HEADERS=

# TLS (corporate SSL inspection)
# HTTP_SSL_VERIFY=true
# SSL_CA_BUNDLE=/path/to/corp-ca.pem

# Server
# HOST=0.0.0.0
# PORT=8080
# MCP_PATH=/mcp

# Logging (stdout → App Runner / CloudWatch Application log group)
# PYTHONUNBUFFERED=1
# LOG_LEVEL=DEBUG
# LOG_QUERY_SNIPPET=true
