# Duo OAuth (client credentials) — required (any one naming style)
# CLIENT_ID_BDB= / CLIENT_ID= / client_id=
# CLIENT_SECRET_BDB= / CLIENT_SECRET= / client_secret=

# Optional overrides (defaults match production URLs in mcp_server.py)
# BDB_TOKEN_URL=https://sso-dbbfec7f.sso.duosecurity.com/oauth/DID1LHEMWQZDEGZ7FAXX/token
# CISCO_SCRIPT_JOB_URL=https://scripts.cisco.com/api/v2/jobs/Mykola_Cisco_Docs

# Shared secret: MCP clients must send HTTP header MCP_REQUEST_HEADERS with this exact value.
# Set in AWS App Runner for production; omit locally only for testing.
# MCP_REQUEST_HEADERS=

# TLS (corporate SSL inspection)
# HTTP_SSL_VERIFY=true
# SSL_CA_BUNDLE=/path/to/corp-ca.pem

# Server
# HOST=0.0.0.0
# PORT=8080
# MCP_PATH=/mcp

# Logging (stdout → App Runner / CloudWatch)
# LOG_LEVEL=INFO
# LOG_QUERY_SNIPPET=true
